/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/docs
  Cache-Control: no-cache, no-store, must-revalidate

/docs/
  Cache-Control: no-cache, no-store, must-revalidate

/roadmap
  Cache-Control: no-cache, no-store, must-revalidate

/roadmap/
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed Vite assets: long cache is fine, but NEVER use "immutable".
# If Cloudflare SPA/404 fallback ever returns index.html for a missing
# /assets/* path, "immutable" poisons the browser cache for a year and
# triggers: Failed to load module script ... MIME type of "text/html".
/assets/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/figures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
